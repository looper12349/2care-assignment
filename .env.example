# Default is an offline, deterministic demonstration interpreter.
# Set AGENT_MODEL to enable real LangChain model interpretation.
AGENT_MODEL=
OPENAI_API_KEY=

# Cloud experiments are opt-in with `clinic-agent eval-loop --online`.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=clinic-agent-synthetic
LANGSMITH_TRACING=false

# The local app binds to loopback and uses synthetic accounts only.
CLINIC_AGENT_HOST=127.0.0.1
CLINIC_AGENT_PORT=8000
CLINIC_AGENT_DATA_DIR=.data
CLINIC_AGENT_BEHAVIOR_VERSION=v1

# Synthetic clinic clock. Leave empty to use the real UTC clock.
CLINIC_AGENT_FIXED_NOW=

# `clinic-agent serve` generates and stores these locally if left empty.
CLINIC_SERVICE_TOKEN=
CLINIC_SESSION_SECRET=
SCHEDULING_URL=http://127.0.0.1:8002
EVALUATION_URL=http://127.0.0.1:8003
CONVERSATION_URL=http://127.0.0.1:8001

# Patient tracing remains disabled unless explicitly enabled here.
CLINIC_ALLOW_TRACE_UPLOAD=false

# Optional shared storage for Python services. Empty values use local SQLite.
# `scripts/docker` generates separate PostgreSQL databases and credentials.
CONVERSATION_DATABASE_URL=
CHECKPOINT_DATABASE_URL=
SCHEDULING_DATABASE_URL=
EVALUATION_DATABASE_URL=
LANGGRAPH_STRICT_MSGPACK=true
